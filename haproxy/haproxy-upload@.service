[Unit]
Description=Divert heavy Naive/Trojan uploaders by source IP (%i)
Wants=haproxy.service
After=haproxy.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /usr/local/sbin/haproxy-jpe-upload.py --profile %i --window 1800 --threshold 5000000000 --hold 86400 --interval 10
Restart=on-failure
RestartSec=5s
StateDirectory=haproxy-jpe-upload
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
